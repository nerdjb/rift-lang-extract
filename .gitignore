# Byte-compiled / cache
__pycache__/
*.py[cod]
.pytest_cache/

# Packaging
build/
dist/
*.egg-info/

# Environments
.venv/
venv/

# ---------------------------------------------------------------------------
# Extracted game data.
#
# rcextract's output is verbatim game text: copyrighted, and around 50 MB per
# language.  It is deliberately not versioned here.  Regenerate it with:
#
#     rcextract dump --game "$GAME" -l en-US -o en_US.tsv
#
# *.json and *.tsv are ignored everywhere, because that is the shape of both
# rcextract's output and a translation.  Your own translations are meant to
# live in translations/, which is re-included below -- note that a bare
# "!translations/" would NOT be enough, since the file patterns above would
# still match the files inside it.
# ---------------------------------------------------------------------------
*.dsar
*.tsv
*.json
toc.bin
*.localization
rcextract_*

# Your translations, if you want them versioned.  This is a directory the
# project ships; drop .json or .tsv files in it.
!translations/
!translations/*.json
!translations/*.tsv

# Editors / OS
.DS_Store
*.swp
.idea/
.vscode/
